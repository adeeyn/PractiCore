# PractiCore production environment (Hostinger VPS).
# Copy to .env on the SERVER and fill in real values. NEVER commit the real file.
#
#   cp .env.example .env
#   nano .env

# Flask session signing — generate one:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# MySQL on the VPS
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=practicore
DB_PASSWORD=change-me-strong-password
DB_NAME=practicore

# NLP model (en_core_web_sm is small/fast; en_core_web_md is smarter but heavy)
SPACY_MODEL=en_core_web_sm

# After HTTPS works (certbot done), flip these two on so logins use secure cookies:
# SESSION_COOKIE_SECURE=1
# PREFERRED_URL_SCHEME=https

# Gunicorn (defaults work; override only if needed)
# GUNICORN_BIND=127.0.0.1:8000
# GUNICORN_WORKERS=3
